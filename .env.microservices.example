# Reference only: run scripts/dev/prepare_messaging.py to generate PRIVATE credentials.
# Copy these flags into the generated ignored .env.microservices for a fresh store.
# Existing data must follow owner transfer/fence runbooks before enabling writes.
IDENTITY_WRITES_ENABLED=true
CATALOG_WRITES_ENABLED=true
CINEMA_WRITES_ENABLED=true
BOOKING_WRITES_ENABLED=true
PAYMENT_WRITES_ENABLED=true
REVIEW_WRITES_ENABLED=true
AI_WRITES_ENABLED=true
# Bootstrap all 5 Reporting snapshots first, then change this to true.
REPORTING_WRITES_ENABLED=false
PAYMENT_FRONTEND_URL=http://localhost:5173
PAYMENT_VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
PAYMENT_TMN_CODE=
PAYMENT_HASH_SECRET=
REVIEW_SENTIMENT_BACKEND=disabled
