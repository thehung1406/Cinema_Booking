      "exclusiveMinimum": 0,
      "title": "Payment Id",
      "type": "integer"
    },
    "showtime_id": {
      "exclusiveMinimum": 0,
      "title": "Showtime Id",
      "type": "integer"
    },
    "film_id": {
      "exclusiveMinimum": 0,
      "title": "Film Id",
      "type": "integer"
    },
    "theater_id": {
