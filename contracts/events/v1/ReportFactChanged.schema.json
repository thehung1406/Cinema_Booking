{
  "additionalProperties": false,
  "properties": {
    "source": {
      "pattern": "^(booking|payment|catalog|cinema|review)$",
      "title": "Source",
      "type": "string"
    },
    "generation": {
      "format": "uuid",
      "title": "Generation",
      "type": "string"
    },
    "kind": {
      "pattern": "^[a-z_]{1,30}$",
      "title": "Kind",
      "type": "string"
    },
    "key": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Key",
      "type": "string"
    },
    "version": {
      "exclusiveMinimum": 0,
      "title": "Version",
      "type": "integer"
    },
    "changed_at": {
      "format": "date-time",
      "title": "Changed At",
      "type": "string"
    },
    "deleted": {
      "title": "Deleted",
      "type": "boolean"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    }
  },
  "required": [
    "source",
    "generation",
    "kind",
    "key",
    "version",
    "changed_at",
    "deleted",
    "payload"
  ],
  "title": "Fact",
  "type": "object"
}
