  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModerationWrite": {
        "properties": {
          "content_version": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Content Version"
          },
          "status": {
            "type": "string",
            "enum": [
              "approved",
              "rejected",
              "pending"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "content_version",
          "status"
        ],
        "title": "ModerationWrite"
      },
      "ReviewEdit": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 5,
            "title": "Content"
          },
          "content_version": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Content Version"
          }
        },
        "type": "object",
        "required": [
          "content",
          "content_version"
        ],
        "title": "ReviewEdit"
      },
      "ReviewRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "content_version": {
            "type": "integer",
            "title": "Content Version"
          },
          "moderation_status": {
            "type": "string",
            "title": "Moderation Status"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "analysis_status": {
            "type": "string",
            "title": "Analysis Status"
          },
          "sentiment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sentiment"
          },
          "author": {
            "type": "string",
            "title": "Author"
          },
          "is_owner": {
            "type": "boolean",
            "title": "Is Owner",
            "default": false
          },
          "verified_purchase": {
            "type": "boolean",
            "title": "Verified Purchase",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "content",
          "content_version",
          "moderation_status",
          "updated_at",
          "analysis_status",
          "author"
        ],
        "title": "ReviewRead"
      },
      "ReviewWrite": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 5,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "ReviewWrite"
      },
      "SentimentDecisionWrite": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "content_version": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Content Version"
          },
          "analysis_generation": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Analysis Generation"
          },
          "expected_updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expected Updated At"
          },
          "label": {
            "type": "string",
            "enum": [
              "positive",
              "neutral",
              "negative"
            ],
            "title": "Label"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "content_version",
          "analysis_generation",
          "expected_updated_at",
          "label",
          "reason"
        ],
