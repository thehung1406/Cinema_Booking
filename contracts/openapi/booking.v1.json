  "components": {
    "schemas": {
      "BookingCreateRequest": {
        "properties": {
          "userId": {
            "type": "integer",
            "title": "Userid",
            "description": "ID người dùng"
          },
          "showtimeId": {
            "type": "integer",
            "title": "Showtimeid",
            "description": "ID suất chiếu"
          },
          "totalAmount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Totalamount",
            "description": "Tổng tiền"
          },
          "paymentMethod": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Paymentmethod"
          },
          "seats": {
            "items": {
              "$ref": "#/components/schemas/SeatBookingRequest"
            },
            "type": "array",
            "minItems": 1,
            "title": "Seats",
            "description": "Danh sách ghế đặt"
          },
          "reservationId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 36
              },
              {
                "type": "null"
              }
            ],
            "title": "Reservationid"
          },
          "foodItems": {
            "items": {
              "$ref": "#/components/schemas/FoodSelection"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Fooditems"
          }
        },
        "type": "object",
        "required": [
          "userId",
          "showtimeId",
          "totalAmount",
          "paymentMethod",
          "seats"
        ],
        "title": "BookingCreateRequest",
        "description": "Request tạo booking mới"
      },
      "BookingDetailResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "bookingId": {
            "type": "integer",
            "title": "Bookingid"
          },
          "userId": {
            "type": "integer",
            "title": "Userid"
          },
          "showtimeId": {
            "type": "integer",
            "title": "Showtimeid"
          },
          "bookingDate": {
            "type": "string",
            "format": "date-time",
            "title": "Bookingdate"
          },
          "totalAmount": {
            "type": "number",
            "title": "Totalamount"
          },
          "paymentMethod": {
            "type": "string",
            "title": "Paymentmethod"
          },
          "paymentStatus": {
            "type": "string",
            "title": "Paymentstatus"
          },
          "bookingStatus": {
            "type": "string",
            "title": "Bookingstatus"
          },
          "filmTitle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filmtitle"
          },
          "filmImage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filmimage"
          },
          "theaterName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Theatername"
          },
          "roomName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Roomname"
          },
          "showDate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Showdate"
          },
          "startTime": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starttime"
          },
          "fullName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fullname"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "phone": {
            "anyOf": [
              {
