  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "context": {
            "$ref": "#/components/schemas/ToolContext-Input"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ConversationDetail": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "context": {
            "$ref": "#/components/schemas/ToolContext-Output"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageRead"
            },
            "type": "array",
            "title": "Messages"
          },
          "next_before_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Before Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "created_at",
          "updated_at",
          "context",
          "messages"
        ],
        "title": "ConversationDetail"
      },
      "ConversationRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "created_at",
          "updated_at"
        ],
        "title": "ConversationRead"
      },
      "DocumentApproval": {
        "properties": {
          "version": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Version"
          },
          "expected_updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expected Updated At"
          },
          "approved": {
            "type": "boolean",
            "title": "Approved",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "expected_updated_at"
        ],
        "title": "DocumentApproval"
      },
      "DocumentWrite": {
        "properties": {
          "source_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Source Id"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "version": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Version"
          },
          "source_url": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Source Url"
          },
          "effective_at": {
            "type": "string",
            "format": "date-time",
            "title": "Effective At"
          },
          "content": {
            "type": "string",
            "maxLength": 2000000,
            "title": "Content",
            "default": ""
          },
          "provenance": {
            "$ref": "#/components/schemas/KnowledgeProvenance"
          },
          "blocks": {
            "items": {
              "$ref": "#/components/schemas/KnowledgeBlock"
            },
            "type": "array",
            "maxItems": 2000,
            "title": "Blocks"
          },
          "expected_updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "title",
          "version",
          "source_url",
          "effective_at"
        ],
        "title": "DocumentWrite"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KnowledgeBlock": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Text"
          },
          "page_start": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Start"
          },
          "page_end": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Page End"
          },
          "section": {
            "type": "string",
            "maxLength": 300,
            "title": "Section",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "KnowledgeBlock"
      },
      "KnowledgeProvenance": {
        "properties": {
          "source_type": {
            "type": "string",
            "enum": [
              "internal",
              "web",
              "pdf",
              "text"
            ],
            "title": "Source Type",
            "default": "internal"
          },
          "scope": {
            "type": "string",
            "enum": [
              "policy",
              "film_education",
              "reference"
            ],
            "title": "Scope",
            "default": "policy"
          },
          "author": {
            "type": "string",
            "maxLength": 300,
            "title": "Author",
            "default": ""
          },
          "license": {
            "type": "string",
            "maxLength": 300,
            "title": "License",
            "default": ""
          },
          "language": {
            "type": "string",
            "maxLength": 20,
            "title": "Language",
            "default": "vi"
          },
          "checksum": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{64})?$",
            "title": "Checksum",
            "default": ""
          },
          "extraction": {
            "type": "string",
            "maxLength": 100,
            "title": "Extraction",
            "default": "manual-text-v1"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "KnowledgeProvenance"
      },
      "KnowledgeSearch": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "scope": {
            "type": "string",
            "enum": [
              "policy",
              "film_education",
              "reference"
            ],
            "title": "Scope",
            "default": "policy"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "lexical",
              "bm25",
              "dense",
              "hybrid",
              "rerank"
            ],
            "title": "Strategy",
            "default": "bm25"
          },
          "limit": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "KnowledgeSearch"
      },
      "MessageRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "content",
          "metadata",
          "created_at"
        ],
        "title": "MessageRead"
      },
      "ToolContext-Input": {
        "properties": {
          "film_id": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Film Id"
          },
          "theater_id": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Theater Id"
          },
          "show_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Show Date"
          },
          "showtime_id": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Showtime Id"
          },
          "film_name": {
            "type": "string",
            "maxLength": 200,
            "title": "Film Name",
            "default": ""
          },
          "theater_name": {
            "type": "string",
            "maxLength": 200,
            "title": "Theater Name",
            "default": ""
          },
          "genre": {
            "type": "string",
            "maxLength": 100,
            "title": "Genre",
            "default": ""
          },
          "language": {
            "type": "string",
            "maxLength": 100,
            "title": "Language",
            "default": ""
          },
          "city": {
            "type": "string",
            "maxLength": 100,
            "title": "City",
            "default": ""
          },
          "format": {
            "type": "string",
            "maxLength": 50,
            "title": "Format",
            "default": ""
          },
          "duration_max": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 600.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Max"
          },
          "start_after": {
