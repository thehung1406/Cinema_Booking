GATEWAY_LEGACY_ENABLED=false
GATEWAY_CONNECT_TIMEOUT_SECONDS=3
GATEWAY_READ_TIMEOUT_SECONDS=30
GATEWAY_MAX_CONNECTIONS=100
# Local host processes. Compose supplies service DNS origins instead.
GATEWAY_UPSTREAMS={"identity":"http://127.0.0.1:8084","catalog":"http://127.0.0.1:8085","cinema":"http://127.0.0.1:8086","booking":"http://127.0.0.1:8087","payment":"http://127.0.0.1:8088","review":"http://127.0.0.1:8083","ai":"http://127.0.0.1:8082","reporting":"http://127.0.0.1:8089"}
GATEWAY_ENABLED_DOMAINS=["identity","catalog","cinema","booking","payment","review","ai","reporting"]
GATEWAY_REQUIRED_DOMAINS=["identity","booking","payment","reporting"]
