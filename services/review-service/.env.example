REVIEW_DATABASE_URL=postgresql+psycopg2://review_owner:local-example-only@localhost:5432/cinema_review
REVIEW_IDENTITY_ORIGIN=http://localhost:8084
REVIEW_DIRECT_READS_ENABLED=true
REVIEW_CATALOG_ORIGIN=http://localhost:8085
REVIEW_BOOKING_ORIGIN=http://localhost:8087
REVIEW_SERVICE_KEY=replace-with-private-service-credential-at-least-32-characters
REVIEW_WRITES_ENABLED=false
REVIEW_AUTO_APPROVE=false
REVIEW_SENTIMENT_BACKEND=disabled
REVIEW_SENTIMENT_MODEL_PATH=/models/sentiment
REVIEW_SENTIMENT_DEMO_LR_PATH=
REVIEW_SENTIMENT_DEMO_VISOBERT_PATH=
REVIEW_SENTIMENT_REVIEW_THRESHOLD=0.65
REVIEW_SENTIMENT_WINDOW_DAYS=30
REVIEW_SENTIMENT_MIN_REVIEWS=10
REVIEW_MAX_ATTEMPTS=5
REVIEW_RETRY_SECONDS=60
# Relay process only; API and inference worker do not need broker credentials.
REVIEW_AMQP_PUBLIC_URL=
