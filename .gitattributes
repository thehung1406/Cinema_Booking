# Preserve measured artifact bytes and their SHA256SUMS across Windows/Linux.
# These rules do not renormalize unrelated application source files.
docs/reports/evidence/** -text
docs/reports/*.docx binary
pipelines/configs/cinema_four_vi_labels.v1.json -text
pipelines/configs/ai_research.four-vi.v1.json -text
pipelines/configs/four_vi_semantic_inputs.v1.json -text

# Knowledge source checksums and shared snapshot bytes must survive Windows/Linux pulls.
pipelines/knowledge/*.md text eol=lf
pipelines/knowledge/snapshot/** -text

# Keep shared inference metadata byte-stable; store binary models in Git LFS.
pipelines/models/sentiment-demo/** -text
pipelines/models/sentiment-demo/**/*.joblib filter=lfs diff=lfs merge=lfs -text
pipelines/models/sentiment-demo/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
pipelines/models/sentiment-demo/**/*.model filter=lfs diff=lfs merge=lfs -text
pipelines/models/sentiment-demo/visobert/tokenizer.json filter=lfs diff=lfs merge=lfs -text
