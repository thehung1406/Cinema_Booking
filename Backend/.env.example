# ==============================================================================
# CINEMA BOOKING BACKEND CONFIGURATION (.env.example)
# Copy file này thành .env và điền các giá trị thực tế trước khi chạy
# ==============================================================================

# Project Information
PROJECT_NAME="Cinema Booking API"

# JWT Authentication
SECRET_KEY=your_super_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database
POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
# Khi chạy local Python:
DATABASE_URL=postgresql+psycopg2://your_postgres_username:your_postgres_password@localhost:5434/your_database_name
# Khi chạy trong Docker Compose:
# DATABASE_URL=postgresql+psycopg2://your_postgres_username:your_postgres_password@postgres:5432/your_database_name

# Redis Cache & Broker (Seat Lock, Token Blacklist, Celery)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# CORS & Frontend URL
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# VNPay Payment Gateway (Sandbox Config)
TMN_CODE=your_vnpay_tmn_code
HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# SMTP Email Configuration (Celery Background Tasks)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=your_email@example.com
SMTP_TLS=True
