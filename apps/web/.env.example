# ==============================================================================
# CINEMA BOOKING FRONTEND CONFIGURATION (.env.example)
# Copy file này thành .env hoặc .env.local trước khi chạy
# ==============================================================================

# Backend API Endpoint
VITE_API_BASE_URL=/api
VITE_API_PROXY_PATH=/api
# Development: proxy /api unchanged to the gateway.
VITE_API_USE_GATEWAY=true
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
# Rollback: set USE_GATEWAY=false and PROXY_TARGET=http://127.0.0.1:8000.
# Existing .env files with an absolute VITE_API_BASE_URL bypass this proxy.

# App Information
VITE_APP_NAME="Cinema Booking"
VITE_APP_VERSION=1.0.0
